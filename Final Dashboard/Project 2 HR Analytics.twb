        <zone friendly-name='Info Container' h='100000' hidden-by-user='true' id='308' param='vert' type-v2='layout-flow' w='92929' x='6786' y='0'>
          <zone fixed-size='259' forceUpdate='true' h='33333' hidden-by-user='true' id='381' is-fixed='true' type-v2='text' w='92929' x='6786' y='33333'>
            <formatted-text>
              <run bold='true' fontalignment='1' fontcolor='#03c4a1'>Welcome</run>
              <run fontalignment='1' fontcolor='#f5f5f5'> &lt;Full Name&gt;</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#03c4a1'>________________________________________________________________________________</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run bold='true' fontalignment='1' fontcolor='#03c4a1'>Hover</run>
              <run fontalignment='1' fontcolor='#f5f5f5'> over the chart to see more information.</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#f5f5f5'>Click on the chart to </run>
              <run bold='true' fontalignment='1' fontcolor='#03c4a1'>filter</run>
              <run fontalignment='1' fontcolor='#f5f5f5'> the entire dashboard.</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#f5f5f5'>Clieck the switch icon on the top right corner to open the </run>
              <run bold='true' fontalignment='1' fontcolor='#03c4a1'>filter menu</run>
              <run fontalignment='1' fontcolor='#f5f5f5'>.</run>
              <run fontalignment='1'>Æ&#10;</run>
              <run fontalignment='1' fontcolor='#03c4a1'>________________________________________________________________________________</run>
              <run fontalignment='1'>Æ&#10;&#10;</run>
              <run fontalignment='1' fontcolor='#f5f5f5'>This HR Dashboard uses a dataset generated using </run>
