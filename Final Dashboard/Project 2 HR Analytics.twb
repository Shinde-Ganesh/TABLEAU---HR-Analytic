      <aliases enabled='yes' />
      <column caption='% Total Hired' datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0512706798272513] / TOTAL([Calculation_0512706798272513])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Total Hired' datatype='integer' name='[Calculation_0512706798272513]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Employee_ID])' />
      </column>
      <column caption='Total Terminated' datatype='integer' name='[Calculation_0512706798485506]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF NOT ISNULL([Termdate]) THEN [Employee_ID] END)' />
      </column>
      <column caption='Total Active' datatype='integer' name='[Calculation_0512706802241540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT(IF ISNULL([Termdate]) THEN [Employee_ID] END)' />
      </column>
      <column caption='Location' datatype='string' name='[Calculation_0512706813087751]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [State]&#13;&#10;    WHEN &apos;New York&apos; THEN &apos;HQ&apos;&#13;&#10;    ELSE &apos;Branch&apos;&#13;&#10;END' />
      </column>
      <column caption='Full Name' datatype='string' name='[Calculation_0942621850009602]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[First Name] + &apos; &apos; + [Last Name]' />
      </column>
      <column caption='Length of Hire' datatype='integer' name='[Calculation_0942621856722947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([Termdate]) &#13;&#10;THEN DATEDIFF(&apos;year&apos; , [Hiredate] , TODAY())&#13;&#10;ELSE DATEDIFF(&apos;year&apos; , [Hiredate] , [Termdate])&#13;&#10;END' />
      </column>
      <column caption='Status' datatype='string' name='[Calculation_1084183573553152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Termdate]) THEN &apos;Hired&apos;&#13;&#10;ELSE &apos;Terminated&apos;&#13;&#10;END' />
      </column>
      <column caption='Highlight Max' datatype='boolean' name='[Calculation_1084183580438529]' role='measure' type='nominal'>
        <calculation class='tableau' formula='WINDOW_MAX([Calculation_0512706798272513])=[Calculation_0512706798272513]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Age' datatype='integer' name='[Calculation_1149874072576000]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,[Birthdate],TODAY())' />
      </column>
      <column caption='Age Groups' datatype='string' name='[Calculation_1149874073530369]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1149874072576000] &lt; 25 then &apos;&gt;25&apos;&#13;&#10;ELSEIF [Calculation_1149874072576000] &gt;=25 AND [Calculation_1149874072576000] &lt; 35 THEN &apos;25-34&apos;&#13;&#10;ELSEIF [Calculation_1149874072576000] &gt;=35 AND [Calculation_1149874072576000] &lt; 45 THEN &apos;35-44&apos;&#13;&#10;ELSEIF [Calculation_1149874072576000] &gt;=45 AND [Calculation_1149874072576000] &lt; 55 THEN &apos;45-54&apos;&#13;&#10;ELSEIF [Calculation_1149874072576000] &gt;=55 THEN &apos;55+&apos;&#13;&#10;END' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Education Level]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;High School&quot;' value='H School' />
        </aliases>
      </column>
      <column caption='Employee ID' datatype='string' name='[Employee_ID]' role='dimension' type='nominal' />
      <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
      <column caption='% Highlight Max' datatype='boolean' name='[Highlight Max (copy)_1084183583633412]' role='measure' type='nominal'>
